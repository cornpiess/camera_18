{
  "name": "aperture-camera",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "verify": "npm run typecheck && npm run lint && npm run doctor",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "build:ios:dev": "npx eas-cli build --platform ios --profile development",
    "prepackage": "node scripts/prepackage-check.js"
  },
  "dependencies": {
    "@react-native-community/slider": "5.1.2",
    "camera-engine": "file:modules/camera-engine",
    "monetization": "file:modules/monetization",
    "expo": "^55.0.0",
    "expo-dev-client": "~55.0.14",
    "expo-document-picker": "~55.0.8",
    "expo-file-system": "~55.0.10",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.8",
    "expo-status-bar": "~55.0.4",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-svg": "15.15.3",
    "expo-asset": "~55.0.20"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~55.0.0",
    "typescript": "~5.9.2"
  }
}
